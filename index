function aiSummary(arr){if(!arr||!arr.length)return "Not run";var s=arr.map(function(a){return a.state});return s.indexOf("Issues found")>-1||s.indexOf("Issues sent")>-1?"Issues found":s.every(function(x){return x==="Passed"})?"All passed":"Partly checked"}
