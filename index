<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Media Buyer Console</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: dark top bar + left section rail + light work area, same bones as XMP so the team moves between them without relearning */
:root{
  --nav:#161b24; --nav-fg:#e8ecf3; --nav-mut:#8d97a8;
  --bg:#eef1f6; --surface:#ffffff; --surface2:#f6f8fb; --line:#dfe4ec;
  --fg:#18202d; --mut:#5d6779; --accent:#2f6df6; --accent-soft:#e4ecff; --accent-fg:#ffffff;
  --ok:#1e8e5a; --ok-bg:#d9f1e4; --warn:#9a6a00; --warn-bg:#fbeab9; --risk:#b3322a; --risk-bg:#f7d4d0; --dead:#ffffff; --dead-bg:#c4372d;
  --info-bg:#e4ecff; --shadow:0 1px 2px rgba(20,30,50,.06);
  --font:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif; --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --nav:#0d1117; --nav-fg:#e8ecf3; --nav-mut:#7d8798;
  --bg:#12161d; --surface:#1a2029; --surface2:#202733; --line:#2b3442;
  --fg:#e6eaf1; --mut:#97a1b3; --accent:#6c97ff; --accent-soft:#223052; --accent-fg:#0b1220;
  --ok:#52c789; --ok-bg:#16382a; --warn:#e5b94a; --warn-bg:#3a3012; --risk:#ff8a80; --risk-bg:#40201e; --dead:#fff; --dead-bg:#b3322a;
  --info-bg:#223052; --shadow:none; color-scheme:dark; } }
:root[data-theme="dark"]{
  --nav:#0d1117; --nav-fg:#e8ecf3; --nav-mut:#7d8798;
  --bg:#12161d; --surface:#1a2029; --surface2:#202733; --line:#2b3442;
  --fg:#e6eaf1; --mut:#97a1b3; --accent:#6c97ff; --accent-soft:#223052; --accent-fg:#0b1220;
  --ok:#52c789; --ok-bg:#16382a; --warn:#e5b94a; --warn-bg:#3a3012; --risk:#ff8a80; --risk-bg:#40201e; --dead:#fff; --dead-bg:#b3322a;
  --info-bg:#223052; --shadow:none; color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--font);font-size:13px;line-height:1.45;padding-left:max(0px,env(safe-area-inset-left,0px));padding-right:max(0px,env(safe-area-inset-right,0px))}
button,input,select,textarea{font:inherit;color:inherit}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--nav);color:var(--nav-fg);display:flex;align-items:center;gap:20px;padding:0 16px;height:46px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--nav)}
.brand{font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;white-space:nowrap}
.brand i{width:18px;height:18px;border-radius:4px;background:var(--accent);display:inline-block}
.top nav{display:flex;gap:4px;overflow-x:auto;min-width:0}
.top nav a{cursor:pointer;color:var(--nav-mut);text-decoration:none;padding:13px 10px;white-space:nowrap}
.top nav a.on{color:var(--nav-fg);box-shadow:inset 0 -2px var(--accent)}
.top .sp{flex:1}
.top .me{display:flex;align-items:center;gap:8px;white-space:nowrap;color:var(--nav-mut)}
.top .me b{color:var(--nav-fg);font-weight:500}
.avatar{width:26px;height:26px;border-radius:50%;background:var(--accent);color:var(--accent-fg);display:grid;place-items:center;font-weight:600;font-size:11px}
.shell{display:grid;grid-template-columns:210px minmax(0,1fr);min-height:calc(100vh - 46px)}
.rail{background:var(--surface);border-right:1px solid var(--line);padding:12px 8px;position:sticky;top:calc(46px + env(safe-area-inset-top,0px));align-self:start;height:calc(100vh - 46px);overflow:auto}
.rail h6{margin:14px 10px 6px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);font-weight:600}
.rail a{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 10px;border-radius:6px;color:var(--fg);text-decoration:none;cursor:pointer}
.rail a:hover{background:var(--surface2)}
.rail a.on{background:var(--accent-soft);color:var(--accent);font-weight:500}
.cnt{font-family:var(--mono);font-size:11px;background:var(--surface2);border:1px solid var(--line);border-radius:10px;padding:0 7px;color:var(--mut)}
.cnt.hot{background:var(--risk-bg);color:var(--risk);border-color:transparent}
main{padding:18px 20px 70px;min-width:0}
.view{display:none}.view.on{display:block}
.ph{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.ph h1{margin:0;font-size:19px;font-weight:600}
.ph p{margin:2px 0 0;color:var(--mut)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);min-width:0}
.card>h3{margin:0;padding:11px 14px;border-bottom:1px solid var(--line);font-size:13px;font-weight:600;display:flex;justify-content:space-between;align-items:center;gap:10px}
.card .b{padding:14px}
.grid{display:grid;gap:14px}
.g4{grid-template-columns:repeat(4,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g21{grid-template-columns:minmax(0,2fr) minmax(0,1fr)}
.stat{padding:12px 14px}.stat small{color:var(--mut);display:block}.stat b{font-size:22px;font-weight:600;font-family:var(--mono)}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:6px 12px;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--surface2)}
.btn.p{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.btn.p:hover{filter:brightness(1.08)}
.btn.d{color:var(--risk);border-color:var(--risk-bg)}
.btn.sm{padding:3px 9px;font-size:12px}
input[type=text],input[type=date],input[type=number],select,textarea{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:6px 9px;min-width:0}
input:focus,select:focus,button:focus-visible,textarea:focus{outline:2px solid var(--accent);outline-offset:1px}
label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--mut)}
label.f>*:not(span){color:var(--fg)}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%}
th{text-align:left;font-weight:500;color:var(--mut);font-size:12px;background:var(--surface2);white-space:nowrap}
th,td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
tr:last-child td{border-bottom:0}
tbody tr.click{cursor:pointer}tbody tr.click:hover{background:var(--surface2)}
.mono{font-family:var(--mono);font-size:12px}
.pill{display:inline-flex;align-items:center;gap:5px;padding:1px 8px;border-radius:10px;font-size:12px;white-space:nowrap;background:var(--surface2);border:1px solid var(--line)}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.pill.ok{background:var(--ok-bg);color:var(--ok);border-color:transparent}
.pill.warn{background:var(--warn-bg);color:var(--warn);border-color:transparent}
.pill.risk{background:var(--risk-bg);color:var(--risk);border-color:transparent}
.pill.dead{background:var(--dead-bg);color:var(--dead);border-color:transparent}
.pill.info{background:var(--info-bg);color:var(--accent);border-color:transparent}
.pill.mute{color:var(--mut)}
.tag{font-size:10px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;padding:1px 6px;border-radius:4px}
.t-b{background:var(--accent-soft);color:var(--accent)}.t-s{background:var(--warn-bg);color:var(--warn)}.t-d{background:var(--ok-bg);color:var(--ok)}
.pipe{display:flex;gap:3px;flex-wrap:wrap}
.pipe span{font-size:11px;padding:2px 7px;border-radius:4px;background:var(--surface2);color:var(--mut);border:1px solid var(--line)}
.pipe span.done{background:var(--ok-bg);color:var(--ok);border-color:transparent}
.pipe span.cur{background:var(--accent);color:var(--accent-fg);border-color:transparent}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:4px 11px;cursor:pointer;display:inline-flex;gap:6px;align-items:center}
.chip.on{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}
.chip .cnt{background:transparent;border:0;padding:0}
.sheet td,.sheet th{border:1px solid var(--line);padding:0}
.sheet th{padding:6px 8px;position:sticky;top:0}
.sheet td input{width:100%;border:0;border-radius:0;background:transparent;padding:7px 8px;min-width:110px}
.sheet td input:focus{outline:2px solid var(--accent);outline-offset:-2px;background:var(--surface)}
.sheet td.lock{background:var(--surface2)}
.sheet td.lock input{color:var(--mut)}
.check{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--line)}
.check:last-child{border:0}
.ic{width:18px;height:18px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:11px;font-weight:700;margin-top:1px}
.ic.ok{background:var(--ok-bg);color:var(--ok)}.ic.bad{background:var(--risk-bg);color:var(--risk)}.ic.wait{background:var(--warn-bg);color:var(--warn)}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.seg button{border:0;background:var(--surface);padding:6px 12px;cursor:pointer;border-right:1px solid var(--line)}
.seg button:last-child{border:0}.seg button.on{background:var(--accent);color:var(--accent-fg)}
.feed{display:flex;flex-direction:column}
.feed .it{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;padding:11px 14px;border-bottom:1px solid var(--line);align-items:start}
.feed .it:last-child{border:0}
.feed .it b{font-weight:500}
.feed .meta{color:var(--mut);font-size:12px;margin-top:2px}
.act{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}
.note{background:var(--info-bg);color:var(--fg);border-radius:6px;padding:8px 11px;font-size:12px}
.bar{height:7px;background:var(--surface2);border-radius:4px;overflow:hidden;border:1px solid var(--line)}.bar i{display:block;height:100%;background:var(--accent)}
.fab{position:fixed;right:max(18px,env(safe-area-inset-right,0px));bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:40;border:0;border-radius:24px;background:var(--accent);color:var(--accent-fg);padding:11px 16px;font-weight:500;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.25)}
.chat{position:fixed;right:max(18px,env(safe-area-inset-right,0px));bottom:calc(70px + env(safe-area-inset-bottom,0px));width:340px;max-width:calc(100vw - 36px);height:430px;max-height:calc(100vh - 140px);z-index:40;display:none;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.25)}
.chat.on{display:flex}
.chat header{padding:10px 14px;border-bottom:1px solid var(--line);font-weight:600;display:flex;justify-content:space-between}
.chat .msgs{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:8px}
.m{padding:8px 10px;border-radius:8px;max-width:88%}.m.u{background:var(--accent);color:var(--accent-fg);align-self:flex-end}.m.a{background:var(--surface2);border:1px solid var(--line)}
.chat form{display:flex;gap:6px;padding:10px;border-top:1px solid var(--line)}.chat form input{flex:1}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(24px + env(safe-area-inset-bottom,0px));background:var(--nav);color:var(--nav-fg);padding:9px 16px;border-radius:8px;z-index:60;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.on{opacity:1}
.two{display:grid;gap:14px;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)}
.kv{display:grid;grid-template-columns:130px minmax(0,1fr);gap:6px 12px}.kv dt{color:var(--mut)}.kv dd{margin:0}
.pm th:first-child,.pm td:first-child{text-align:left}.pm td,.pm th{text-align:center}.pm td:first-child{text-align:left}
@media (max-width:900px){
  .shell{grid-template-columns:minmax(0,1fr)}
  .rail{position:static;height:auto;display:flex;gap:4px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);padding:8px}
  .rail h6{display:none}.rail a{white-space:nowrap}
  .g4,.g3{grid-template-columns:repeat(2,minmax(0,1fr))}.g2,.g21,.two{grid-template-columns:minmax(0,1fr)}
  .top .me span{display:none}.top nav{display:none}
  main{padding:14px 16px 80px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header class="top">
  <div class="brand"><i></i>AdOps Console</div>
  <nav id="topnav"><a data-go="tasks" class="on">Campaigns</a><a data-go="pages">Pages</a><a data-go="accounts">Accounts</a><a data-go="alerts">Alerts</a></nav>
  <div class="sp"></div>
  <div class="me"><span>Media Buyer</span><b>Rohan (demo)</b><div class="avatar">R</div></div>
</header>

<div class="shell">
<aside class="rail" id="rail">
  <h6>Work</h6>
  <a data-v="overview">Overview</a>
  <a data-v="tasks">My tasks <span class="cnt">6</span></a>
  <a data-v="new">New task</a>
  <a data-v="review">Review queue <span class="cnt hot" id="nRev">0</span></a>
  <h6>Monitor</h6>
  <a data-v="live">Live campaigns <span class="cnt">14</span></a>
  <a data-v="rules">Rejection rules</a>
  <a data-v="alerts">Alerts <span class="cnt hot" id="nAl">0</span></a>
  <h6>Data</h6>
  <a data-v="pages">Pages</a>
  <a data-v="accounts">Ad accounts</a>
  <a data-v="templates">Templates</a>
  <a data-v="history">History</a>
</aside>

<main>
<!-- OVERVIEW -->
<section class="view" id="v-overview">
  <div class="hero">
    <div><div class="hs">Tuesday, 20 Oct 2026</div><h1>Good afternoon, Rohan</h1><p id="heroSum"></p></div>
    <div class="row"><button class="hb" data-go="new">+ New task</button><button class="hb" data-go="review">Review queue</button><button class="hb" data-go="rules">Rejection rules</button></div>
  </div>
  <div class="grid g4" style="margin-bottom:14px" id="kpis"></div>
  <div class="grid g21" style="margin-bottom:14px">
    <div class="grid" style="align-content:start">
      <div class="card"><h3>Task pipeline <button class="btn sm" data-go="tasks">All tasks</button></h3><div class="b"><div class="steps" id="homePipe"></div></div></div>
      <div class="card"><h3>Spend, last 7 days <span class="meta" style="font-weight:400;color:var(--mut)">All your accounts</span></h3><div class="b" id="spendChart"></div></div>
      <div class="card"><h3>Page health <button class="btn sm" data-go="pages">Open pages</button></h3><div class="b" id="pgHealth"></div></div>
    </div>
    <div class="card" style="align-self:start"><h3>Alerts <button class="btn sm" data-gal="All">View all</button></h3>
      <div class="tabs" id="hmTabs" style="padding:10px 14px 0"></div>
      <div class="feed" id="hmFeed"></div></div>
  </div>
</section>

<!-- TASKS -->
<section class="view" id="v-tasks">
  <div class="ph"><div><h1>My tasks</h1><p>Every campaign task you created and where it is in the flow.</p></div>
    <div class="row"><label class="f"><span>From</span><input type="date" value="2026-10-14"></label><label class="f"><span>To</span><input type="date" value="2026-10-20"></label><button class="btn p" data-go="new" style="align-self:flex-end">+ New task</button></div></div>
  <div class="tabs" style="margin-bottom:12px" id="taskTabs"></div>
  <div class="card"><div class="tw"><table><thead><tr><th>Task</th><th>Product / geo</th><th>Campaigns × ads</th><th>Stage</th><th>Supplier</th><th>Designer</th><th>Updated</th></tr></thead><tbody id="taskRows"></tbody></table></div></div>
</section>

<!-- NEW TASK -->
<section class="view" id="v-new">
  <div class="ph"><div><h1>New campaign task</h1><p>You fill the blue columns. Supplier and designer fill their own columns. Everything is checked before it can go to review.</p></div>
    <div class="row"><button class="btn" data-toast="Draft saved">Save draft</button><button class="btn p" data-toast="Sent to supplier and designer">Send to team</button></div></div>
  <div class="card" style="margin-bottom:14px"><h3>Setup</h3><div class="b grid g4">
    <label class="f"><span>Template</span><select id="ntTpl"></select></label>
    <label class="f"><span>Date in names (auto)</span><input type="text" value="20/10" disabled></label>
    <label class="f"><span>Parallel tabs</span><select><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5 (system max)</option></select></label>
    <label class="f"><span>Publish</span><select><option>As soon as master approves</option><option>Schedule for a time</option></select></label>
    <label class="f" style="grid-column:span 2"><span>Cover images</span><div class="seg" id="coverSeg"><button class="on" data-m="r">Random from folder</button><button data-m="s">Match video name</button></div></label>
    <label class="f" id="coverFolder" style="grid-column:span 2"><span>Cover folder and repeat limit</span><div class="row"><input type="text" value="NEW TEW1 / covers (498 files)" style="flex:1"><label class="row" style="gap:6px;color:var(--fg)">Max repeats <input type="number" value="1" min="1" style="width:60px"></label></div></label>
  </div></div>
  <div class="card"><h3>Campaign sheet <span class="row" style="font-weight:400"><span class="tag t-b">Buyer</span><span class="tag t-s">Supplier</span><span class="tag t-d">Designer</span></span></h3>
    <div class="tw"><table class="sheet"><thead><tr>
      <th><span class="tag t-b">Buyer</span> Product</th><th><span class="tag t-b">Buyer</span> Promoted app / ID</th><th><span class="tag t-b">Buyer</span> Countries</th><th><span class="tag t-b">Buyer</span> Ad sets</th><th><span class="tag t-b">Buyer</span> Daily budget</th><th><span class="tag t-b">Buyer</span> Bid strategy</th><th><span class="tag t-b">Buyer</span> CPR goal</th>
      <th><span class="tag t-s">Supplier</span> Ad account ID</th><th><span class="tag t-s">Supplier</span> Page name / ID</th>
      <th><span class="tag t-d">Designer</span> Video range</th><th><span class="tag t-d">Designer</span> Primary text</th><th><span class="tag t-d">Designer</span> Headline</th></tr></thead>
    <tbody>
      <tr><td><input type="text" value="VDHP 159"></td><td><input type="text" value="VD 159 AE,SA,NL / 2079112532809195"></td><td><input type="text" value="AE, NL"></td><td><input type="number" value="2"></td><td><input type="text" value="$400"></td><td><input type="text" value="Cost cap"></td><td><input type="text" value="$0.40"></td>
        <td class="lock"><input type="text" value="1570337628451061" readonly></td><td class="lock"><input type="text" value="Julian Young / 1323659637503856" readonly></td><td class="lock"><input type="text" value="TEW 001–030" readonly></td><td class="lock"><input type="text" value="Story set A (2,790 chars)" readonly></td><td class="lock"><input type="text" value="एक संगीत विद्यालय में गई।" readonly></td></tr>
      <tr><td><input type="text" value="VDHP 159"></td><td><input type="text" value="VD 159 AE,SA,NL / 2079112532809195"></td><td><input type="text" value="AE, NL"></td><td><input type="number" value="2"></td><td><input type="text" value="$400"></td><td><input type="text" value="Cost cap"></td><td><input type="text" value="$0.40"></td>
        <td class="lock"><input type="text" placeholder="waiting for supplier" readonly></td><td class="lock"><input type="text" placeholder="waiting for supplier" readonly></td><td class="lock"><input type="text" placeholder="waiting for designer" readonly></td><td class="lock"><input type="text" placeholder="waiting for designer" readonly></td><td class="lock"><input type="text" placeholder="waiting for designer" readonly></td></tr>
    </tbody></table></div>
    <div class="b"><div class="note">Greyed cells belong to supplier or designer and are read-only for you. Dates, naming pattern, EU beneficiary and CTA come from the template, so nobody types them.</div></div></div>
</section>

<!-- REVIEW -->
<section class="view" id="v-review">
  <div class="ph"><div><h1>Review queue</h1><p>Tick one or more tasks (or click a row). Each ticked task opens below, one under another, so you can check it and send it to master or back to supplier or designer.</p></div></div>
  <div id="g-rev"></div>
  <div class="card" style="margin-top:14px"><div class="gh"><div class="row"><span id="rvCnt"></span><span id="rvChips" class="tabs"></span></div><div class="row"><button class="btn" id="rvAiAll">AI check all open</button><button class="btn p" id="rvSubAll">Submit all open to master</button><button class="btn" id="rvCloseAll">Close all</button></div></div></div>
  <div id="rvPanels" style="display:flex;flex-direction:column;gap:14px;margin-top:14px"></div>
</section>

<!-- LIVE -->
<section class="view" id="v-live">
