function acTone(c){return ACATS.filter(function(x){return x[0]===c})[0][1]}
function unread(){return ALERTS.filter(function(a){return!AREAD[a.id]})}
function alertRow(a,compact){return '<div class="it" style="'+(AREAD[a.id]?"opacity:.6":"")+'"><span class="pill '+(a.sev==="High"?"risk":a.sev==="Medium"?"warn":"info")+'">'+a.sev+'</span><div><b>'+a.t+'</b> <span class="pill '+acTone(a.cat)+'" style="font-size:11px;padding:0 6px">'+a.cat+'</span><div class="meta">'+a.d+'</div><div class="act"><button class="btn p sm" data-alg="'+a.id+'">'+a.btn+'</button>'+(compact?'':(AREAD[a.id]?'<button class="btn sm" data-alu="'+a.id+'">Mark unread</button>':'<button class="btn sm" data-alr="'+a.id+'">Mark read</button>'))+'</div></div><span class="meta">'+a.w+'</span></div>'}
function catTabs(sel,attr){var un=unread();return [["All",""]].concat(ACATS).map(function(c){var n=un.filter(function(a){return c[0]==="All"||a.cat===c[0]}).length;return '<button class="chip '+(c[0]===sel?"on":"")+'" '+attr+'="'+c[0]+'">'+c[0]+' <span class="cnt">'+n+'</span></button>'}).join("")}
