var AIV={},AIAUTO={},AIFORCE={},AIFN=function(){return[]},AISUBMIT=function(){},AIBY="My agent";
function aiE(s){return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function aiTone(s){return s==="Passed"||s==="All passed"?"ok":s==="Issues found"?"risk":s==="Issues sent"||s==="Partly checked"?"warn":"mute"}
function aiPill(s,pre){return '<span class="pill '+aiTone(s)+'">'+(pre===false?"":"AI: ")+s+'</span>'}
function aiNowT(){var d=new Date();return ("0"+d.getHours()).slice(-2)+":"+("0"+d.getMinutes()).slice(-2)}
function aiRun(id,by){var items=AIFN(id),bad=items.filter(function(i){return i.s==="bad"}).length;
  AIV[id]={state:bad?"Issues found":"Passed",by:by||AIBY,at:aiNowT(),items:items};return AIV[id]}
function aiIc(s){return '<span class="aiic '+s+'">'+(s==="ok"?"✓":s==="bad"?"×":"!")+'</span>'}
function aiBox(id,title){var v=AIV[id],auto=AIAUTO[id]!==false,bad=v?v.items.filter(function(i){return i.s==="bad"}).length:0;
  var h='<div class="aib" id="ai-'+id+'"><div class="aih"><b>'+(title||"AI check")+'</b> '+(v?aiPill(v.state)+' <span class="meta" style="color:var(--mut)">'+aiE(v.by)+' · '+v.at+'</span>':aiPill("Not run"))+'<span style="flex:1"></span><label class="aiau"><input type="checkbox" data-aiauto="'+id+'"'+(auto?' checked':'')+'> Let AI check before I submit</label><button class="btn sm" data-aic="'+id+'">'+(v?"Run again":"Run AI check now")+'</button></div>';
  if(v&&v.items.length)h+='<div class="ail">'+v.items.map(function(i){return '<div class="aii">'+aiIc(i.s)+'<div style="flex:1">'+aiE(i.t)+'</div>'+(i.go?'<button class="btn sm" data-go="'+i.go+'">'+aiE(i.fix||"Open")+'</button>':'')+(i.gotx?'<button class="btn sm" data-gotx="'+i.gotx+'">'+aiE(i.fix||"Open")+'</button>':'')+'</div>'}).join("")+'</div>';
  else h+='<div class="aihint">'+(auto?"AI will check everything when you press Submit. Press Run to see the result first.":"AI check is off. The next team will see “Not run”.")+'</div>';
  if(bad)h+='<div class="aiwarn"><span>'+bad+' problem'+(bad>1?"s":"")+' found. Fix them and run again, or send as it is. The next team will see “Issues sent”.</span><button class="btn sm d" data-aiforce="'+id+'">Submit anyway</button></div>';
  return h+'</div>'}
function aiRefresh(id){Array.prototype.slice.call(document.querySelectorAll('[id="ai-'+id+'"]')).forEach(function(e){var t=document.createElement("div");t.innerHTML=aiBox(id);e.parentNode.replaceChild(t.firstChild,e)})}
/* gate: true = go ahead and submit. Records what the next team will see. */
function aiGate(id){if(AIAUTO[id]===false){AIV[id]={state:"Not run",by:"Skipped by "+AIBY,at:aiNowT(),items:[]};return true}
  var v=aiRun(id);if(v.state==="Passed")return true;
